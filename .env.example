# Modèle de génération compact. Q4_K_M occupe environ 1,4 Go.
VIGILIA_MODEL=qwen3:1.7b
# Modèle d'embeddings optionnel. Sans lui, la recherche FTS5 reste active.
VIGILIA_EMBED_MODEL=qwen3-embedding:0.6b
VIGILIA_OLLAMA_URL=http://127.0.0.1:11434
VIGILIA_DB=./data/vigilia.db
VIGILIA_TOP_K=6
# Similarité cosinus minimale pour accepter un passage sémantique.
VIGILIA_DENSE_MIN_SCORE=0.45
